# FinTrust Hub 前端开发环境变量 (APP-02 PWA MVP)
# 复制/参考 .env.example 调整

# 后端 API 地址 (开发期走 Vite 代理: 留空 → client.ts 用相对 /api/v1, proxy 转发到 localhost:8000)
# 重要: 必须留空! 若写 http://localhost:8000, 手机上 localhost 指向手机自身 → 移动端全部网络异常
# 注: 后端路由统一前缀 /api/v1, client.ts 默认 baseURL = /api/v1
VITE_BACKEND_URL=

# 应用元信息
VITE_APP_TITLE=FinTrust Hub
VITE_APP_VERSION=3.1.0

# WebSocket 地址 (实时事件推送)
VITE_WS_URL=ws://localhost:8000/ws

# APP-02: 工人登录开发降级 (前端只读标记; 实际降级由后端 WORKER_AUTH_BYPASS 控制,
# 后端在 APP_ENV=production 时强制关闭, 任何前端配置都无法在生产开启绕过)
VITE_WORKER_AUTH_BYPASS=true
