# FinTrust Hub 前端环境变量
# 复制此文件为 .env / .env.development / .env.production 后填入实际值

# 后端 API 地址 (开发期指向本地 FastAPI)
VITE_BACKEND_URL=http://localhost:8000

# 应用元信息
VITE_APP_TITLE=FinTrust Hub
VITE_APP_VERSION=3.1.0

# WebSocket 地址 (实时事件推送: 改造调度进度 / 竞拍出价 / 告警)
VITE_WS_URL=ws://localhost:8000/ws

# DeepSeek API (仅前端兜底调试用, 生产环境必须经后端代理)
VITE_DEEPSEEK_API_KEY=
