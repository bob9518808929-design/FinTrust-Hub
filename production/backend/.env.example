# FinTrust Hub 后端环境变量
# 复制此文件为 .env 后填入实际值

# === 应用 ===
APP_NAME=FinTrust Hub Backend
APP_VERSION=3.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# === 数据库 ===
DATABASE_URL=postgresql+asyncpg://fintrust:fintrust@localhost:5432/fintrust_hub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# === Redis ===
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# === ClickHouse ===
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fintrust_metrics
# 连接/查询超时 (秒), 超时降级到 debug 日志不阻断业务, 见 clickhouse_client.py
CLICKHOUSE_CONNECT_TIMEOUT=5
CLICKHOUSE_QUERY_TIMEOUT=10
# LLM 指标落库开关 (P1 _record_metric 失败时打 debug 日志), 见 llm_service.py
LLM_METRICS_ENABLED=true
LLM_METRICS_LOG_ON_FAILURE=true

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fintrust

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=fintrust-hub

# === DeepSeek / LLM ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === JWT ===
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# APP-02: 工人 JWT 7 天过期 (分钟)
WORKER_JWT_EXPIRE_MINUTES=10080
# APP-02: 工人登录开发降级 (dev 任意输入返回 mock token; APP_ENV=production 时强制 false)
WORKER_AUTH_BYPASS=true

# === 区块链 ===
ANT_CHAIN_ENDPOINT=
ANT_CHAIN_ACCESS_KEY=
ANT_CHAIN_SECRET=
ZXIN_CHAIN_ENDPOINT=

# === OCR ===
PADDLE_OCR_LANG=ch
CLOUD_OCR_PROVIDER=aliyun
CLOUD_OCR_KEY=

# === 时序任务 ===
TEMPORAL_HOST=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=fintrust
TEMPORAL_TASK_QUEUE=fintrust-queue

# === 外部 API 档 (INFRA-01b) ===
# 银企直连 (A1-A4): 需银行授权 + 数字证书 + API 密钥
BANK_API_001_URL=                          # 工行银企直连 API 地址
BANK_API_001_APP_ID=                       # 银行分配的应用 ID / Client ID
BANK_API_001_APP_SECRET=                   # 银行分配的应用密钥 / Client Secret
BANK_API_001_CERT_PATH=                    # 银行数字证书 .pfx 文件路径
BANK_API_001_CERT_PASSWORD=                # 证书密码
BANK_API_002_URL=                          # 建行银企直连 API 地址
BANK_API_002_APP_ID=
BANK_API_002_APP_SECRET=
BANK_API_002_CERT_PATH=
BANK_API_002_CERT_PASSWORD=
# 央行征信查询 (A4): 需央行征信中心接入资质
PBOC_CREDIT_API_URL=                      # 人行征信系统 API 地址
PBOC_CREDIT_API_KEY=                      # 征信查询授权码
PBOC_CREDIT_ORG_CODE=                     # 机构信用代码
# 税务数据 (A11)
TAX_API_URL=
TAX_API_KEY=                               # 税务局授权 token
# 工商/发票数据 (A12)
INVOICE_API_URL=
INVOICE_API_KEY=                           # 工商/发票查询授权码

# === 电子签章 (A9) ===
ESIGN_API_URL=                             # e签宝/法大大 API 地址
ESIGN_API_KEY=                             # 电子签章平台 API Key
ESIGN_APP_ID=                              # 电子签章平台 App ID

# === A 档外部数据源 (external_api_config.yaml 对应, 未配置自动降级内存兜底) ===
# 银企直连资金监管 (fund_service: 监管账户余额/划拨/流水)
FUND_SUPERVISION_API_URL=                  # 银企直连资金监管 API 地址
FUND_SUPERVISION_API_KEY=                  # 银企直连授权 token
FUND_SUPERVISION_ORG_CODE=                 # 机构信用代码
# 第三方风控数据源 (risk_service: 天眼查/企查查/百融类企业画像)
RISK_DATA_API_URL=                         # 第三方风控 API 地址
RISK_DATA_API_KEY=                         # 第三方风控授权 token
RISK_DATA_APP_ID=                          # 第三方风控 App ID
# 保司应收账款保险报价 (insurance_service: 人保/平安/太保类)
INSURER_API_URL=                           # 保司报价 API 地址
INSURER_API_KEY=                           # 保司授权 token
INSURER_APP_ID=                            # 保司 App ID
# 核心企业 ERP 数据接口 (scf_service: SC1 画像 / SC8 撮合数据源)
ERP_DATA_API_URL=                          # 核心企业 ERP API 地址
ERP_DATA_API_KEY=                          # ERP 授权 token
ERP_DATA_APP_ID=                           # ERP App ID

# === IoT MQTT (EMQX) ===
MQTT_BROKER_HOST=                          # EMQX broker 地址
MQTT_BROKER_PORT=1883                      # EMQX broker 端口
MQTT_USERNAME=                             # EMQX 用户名
MQTT_PASSWORD=                             # EMQX 密码

# === 通用 LLM 接口 (可选，用于合同提取等) ===
LLM_API_URL=                               # 通用 LLM API 地址
LLM_API_KEY=                               # 通用 LLM API Key
